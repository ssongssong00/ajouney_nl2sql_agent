{
  "section": "2-1",
  "title": "DB · 메타데이터",
  "database": "SQLite 3.51 (Node.js 22 내장 node:sqlite)",
  "summary": "모든 날짜는 TEXT 'YYYY-MM-DD'. relative_signup_day 는 가입일 기준 경과일(가입 당일 = 0). 고객은 2025-02-01~2025-04-01 가입자 50,000명이며, 관측 기간은 테이블마다 다름 — 행동 D0~D30 · 시청 D0~D60 · 결제 D0~D90.",
  "date_rules": {
    "format": "모든 날짜는 TEXT 'YYYY-MM-DD'",
    "shift": "개인정보 보호를 위해 실제 날짜를 365일 이전으로 이동. 상대일 컬럼은 이동과 무관하게 원래 여정을 유지",
    "relative_signup_day": "가입 당일 = 0"
  },
  "observation_window": [
    {
      "table": "behavior_fact",
      "window": "D0~D30"
    },
    {
      "table": "watch_daily_fact",
      "window": "D0~D60"
    },
    {
      "table": "user_content_summary",
      "window": "D0~D60"
    },
    {
      "table": "payment_fact",
      "window": "D0~D90"
    }
  ],
  "preprocessing": [
    "분할 CSV를 UNION ALL로 병합하고, export_part 중복 적재가 없음을 검증한 뒤 컬럼은 제외",
    "날짜 TEXT 'YYYY-MM-DD' · 금액 REAL · 코드값(gender_code, currency_type_id) INTEGER",
    "content_dim NULL은 원본 유지: LIVE content_id 126건, program_id 2건(VOD 1 · LIVE 1)",
    "relative_signup_day = 날짜 − 가입일 정합성 검증 (불일치 0건)"
  ],
  "relationships": [
    {
      "from": "payment_fact.user_key",
      "to": "user_dim.user_key",
      "type": "N:1",
      "join": "payment_fact.user_key = user_dim.user_key",
      "note": "첫 결제만 볼 때는 payment_order = 1 조건을 반드시 추가 (고객당 1행)"
    },
    {
      "from": "behavior_fact.user_key",
      "to": "user_dim.user_key",
      "type": "N:1",
      "join": "behavior_fact.user_key = user_dim.user_key",
      "note": "고객 수는 COUNT(DISTINCT user_key)"
    },
    {
      "from": "watch_daily_fact.user_key",
      "to": "user_dim.user_key",
      "type": "N:1",
      "join": "watch_daily_fact.user_key = user_dim.user_key",
      "note": "결제 후 기간은 relative_signup_day와 첫 결제의 relative_signup_day 차이로 계산"
    },
    {
      "from": "user_content_summary.user_key",
      "to": "user_dim.user_key",
      "type": "N:1",
      "join": "user_content_summary.user_key = user_dim.user_key"
    },
    {
      "from": "user_content_summary.content_key",
      "to": "content_dim.content_key",
      "type": "N:1",
      "join": "user_content_summary.content_key = content_dim.content_key"
    },
    {
      "from": "content_genre_bridge.content_key",
      "to": "content_dim.content_key",
      "type": "N:1 (콘텐츠:장르 = N:M)",
      "join": "content_genre_bridge.content_key = content_dim.content_key",
      "note": "장르 조인 시 고객·콘텐츠가 장르 수만큼 중복되므로 COUNT(DISTINCT) 사용"
    },
    {
      "from": "user_journey.user_key",
      "to": "user_dim.user_key",
      "type": "1:1",
      "join": "user_journey.user_key = user_dim.user_key",
      "note": "user_journey에 user_dim 속성이 이미 포함되어 보통 조인 불필요"
    }
  ],
  "indexes": [
    {
      "name": "idx_watch_user_day",
      "table": "watch_daily_fact",
      "columns": [
        "user_key",
        "relative_signup_day"
      ],
      "reason": "결제 후 D+N 시청 여부 (기간 범위 조회)",
      "status": "verified"
    },
    {
      "name": "idx_genre_cover",
      "table": "content_genre_bridge",
      "columns": [
        "content_key",
        "genre_name"
      ],
      "reason": "장르 조인 커버링 인덱스 → 테이블 접근 생략 (5.3s → 0.75s)",
      "status": "needs_verification"
    },
    {
      "name": "idx_behavior_type_user",
      "table": "behavior_fact",
      "columns": [
        "behavior_type",
        "user_key"
      ],
      "reason": "행동 유형별 고객 수 집계 (VOUCHER_VIEW 등)",
      "status": "needs_verification"
    },
    {
      "name": "idx_pay_order_user",
      "table": "payment_fact",
      "columns": [
        "payment_order",
        "user_key"
      ],
      "reason": "첫 결제(payment_order = 1) 조회",
      "status": "needs_verification"
    }
  ],
